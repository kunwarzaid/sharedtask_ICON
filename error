import json
import os
import re
import torch
import pandas as pd

from tqdm import tqdm
from transformers import AutoTokenizer, AutoModelForCausalLM
from peft import PeftModel

from sklearn.metrics import (
    accuracy_score,
    f1_score,
    classification_report,
    confusion_matrix,
)


# ============================================================
# CONFIG
# ============================================================

BASE_MODEL = "Qwen/Qwen3-8B"

ADAPTER_PATH = (
    "./outputs/safety_understanding/"
    "best_adapter"
)

VALID_FILE = (
    "training_data/"
    "safety_understanding_valid.jsonl"
)

OUTPUT_DIR = "./outputs/safety_understanding"

RESULTS_FILE = os.path.join(
    OUTPUT_DIR,
    "validation_predictions.csv"
)

os.makedirs(
    OUTPUT_DIR,
    exist_ok=True
)


# ============================================================
# LOAD DATA
# ============================================================

with open(
    VALID_FILE,
    "r",
    encoding="utf-8",
) as f:

    dataset = [
        json.loads(line)
        for line in f
        if line.strip()
    ]

print(
    "Validation examples:",
    len(dataset)
)


# ============================================================
# LOAD TOKENIZER
# ============================================================

print("Loading tokenizer...")

tokenizer = AutoTokenizer.from_pretrained(
    BASE_MODEL,
    trust_remote_code=True,
)

if tokenizer.pad_token is None:
    tokenizer.pad_token = tokenizer.eos_token


# ============================================================
# LOAD BASE MODEL
# ============================================================

print("Loading base model...")

base_model = AutoModelForCausalLM.from_pretrained(
    BASE_MODEL,
    dtype=torch.bfloat16,
    device_map="auto",
    trust_remote_code=True,
)


# ============================================================
# LOAD LORA
# ============================================================

print("Loading trained adapter...")

model = PeftModel.from_pretrained(
    base_model,
    ADAPTER_PATH,
)

model.eval()

print(
    "Active adapter:",
    model.active_adapter
)


# ============================================================
# JSON PARSER
# ============================================================

def extract_json(text):

    text = text.strip()

    # Remove think block if generated unexpectedly
    text = re.sub(
        r"<think>.*?</think>",
        "",
        text,
        flags=re.DOTALL | re.IGNORECASE,
    ).strip()

    # ideal case
    try:

        result = json.loads(text)

        if isinstance(result, dict):
            return result

    except json.JSONDecodeError:
        pass

    # fallback
    match = re.search(
        r'\{[^{}]*\}',
        text,
        flags=re.DOTALL,
    )

    if match:

        try:
            return json.loads(
                match.group(0)
            )

        except json.JSONDecodeError:
            pass

    return None


# ============================================================
# STORAGE
# ============================================================

results = []

gold_categories = []
pred_categories = []

gold_persuasions = []
pred_persuasions = []

failed_json = 0


# ============================================================
# DEVICE
# ============================================================

device = next(
    model.parameters()
).device


# ============================================================
# EVALUATION
# ============================================================

for idx, example in enumerate(
    tqdm(
        dataset,
        desc="Evaluating",
    )
):

    messages = example["messages"]

    gold = json.loads(
        messages[2]["content"]
    )

    # --------------------------------------------------------
    # CRITICAL
    #
    # This EXACTLY matches the successful diagnostic:
    #
    # assistant
    # <think>
    #
    # </think>
    #
    # [generation begins here]
    #
    # --------------------------------------------------------

    inference_text = tokenizer.apply_chat_template(
        messages[:2],
        tokenize=False,
        add_generation_prompt=True,
        enable_thinking=False,
    )

    inputs = tokenizer(
        inference_text,
        return_tensors="pt",
    )

    # Some tokenizer values can be non-tensors.
    # Move tensors only.
    inputs = {
        key: (
            value.to(device)
            if torch.is_tensor(value)
            else value
        )
        for key, value in inputs.items()
    }

    # --------------------------------------------------------
    # GENERATE
    # --------------------------------------------------------

    with torch.inference_mode():

        outputs = model.generate(
            **inputs,
            max_new_tokens=64,
            do_sample=False,
            eos_token_id=tokenizer.eos_token_id,
            pad_token_id=tokenizer.eos_token_id,
            use_cache=True,
        )

    prompt_length = (
        inputs["input_ids"].shape[1]
    )

    generated_tokens = outputs[0][
        prompt_length:
    ]

    decoded = tokenizer.decode(
        generated_tokens,
        skip_special_tokens=True,
    ).strip()

    prediction = extract_json(
        decoded
    )

    # --------------------------------------------------------
    # DEFAULT VALUES
    # --------------------------------------------------------

    pred_category = "PARSE_FAILED"
    pred_persuasion = "PARSE_FAILED"

    parse_failed = (
        prediction is None
    )

    if parse_failed:

        failed_json += 1

    else:

        pred_category = prediction.get(
            "category",
            "UNKNOWN",
        )

        pred_persuasion = prediction.get(
            "persuasion",
            "UNKNOWN",
        )

    # --------------------------------------------------------
    # IMPORTANT:
    #
    # Include parse failures in metrics.
    # Don't silently throw them away.
    # --------------------------------------------------------

    gold_categories.append(
        gold["category"]
    )

    pred_categories.append(
        pred_category
    )

    gold_persuasions.append(
        gold["persuasion"]
    )

    pred_persuasions.append(
        pred_persuasion
    )

    results.append(
        {
            "index": idx,

            "gold_category":
                gold["category"],

            "pred_category":
                pred_category,

            "category_correct":
                gold["category"]
                == pred_category,

            "gold_persuasion":
                gold["persuasion"],

            "pred_persuasion":
                pred_persuasion,

            "persuasion_correct":
                gold["persuasion"]
                == pred_persuasion,

            "json_parse_failed":
                parse_failed,

            "raw_prediction":
                decoded,
        }
    )

    # Show first 10
    if idx < 10:

        print("\n" + "=" * 70)
        print("EXAMPLE", idx)
        print("=" * 70)

        print(
            "GOLD:",
            gold
        )

        print(
            "RAW:",
            repr(decoded)
        )

        print(
            "PARSED:",
            prediction
        )

    # Save periodically
    if (
        (idx + 1) % 50 == 0
        or
        idx + 1 == len(dataset)
    ):

        pd.DataFrame(
            results
        ).to_csv(
            RESULTS_FILE,
            index=False,
            encoding="utf-8-sig",
        )


# ============================================================
# JSON VALIDITY
# ============================================================

total = len(dataset)

successful_json = (
    total - failed_json
)

json_validity = (
    successful_json / total
)


print("\n")
print("=" * 70)
print("JSON VALIDITY")
print("=" * 70)

print(
    "Total examples:",
    total
)

print(
    "Valid JSON:",
    successful_json
)

print(
    "Failed JSON:",
    failed_json
)

print(
    "JSON validity:",
    f"{json_validity:.4f}"
)


# ============================================================
# CATEGORY RESULTS
# ============================================================

cat_accuracy = accuracy_score(
    gold_categories,
    pred_categories,
)

cat_macro_f1 = f1_score(
    gold_categories,
    pred_categories,
    average="macro",
)

print("\n")
print("=" * 70)
print("CATEGORY")
print("=" * 70)

print(
    f"Accuracy: {cat_accuracy:.4f}"
)

print(
    f"Macro F1: {cat_macro_f1:.4f}"
)

print("\nClassification report:")

print(
    classification_report(
        gold_categories,
        pred_categories,
        digits=4,
        zero_division=0,
    )
)

category_labels = sorted(
    set(gold_categories)
    |
    set(pred_categories)
)

print(
    "Category labels:",
    category_labels
)

print("\nConfusion matrix:")

print(
    confusion_matrix(
        gold_categories,
        pred_categories,
        labels=category_labels,
    )
)


# ============================================================
# PERSUASION RESULTS
# ============================================================

pers_accuracy = accuracy_score(
    gold_persuasions,
    pred_persuasions,
)

pers_macro_f1 = f1_score(
    gold_persuasions,
    pred_persuasions,
    average="macro",
)

print("\n")
print("=" * 70)
print("PERSUASION")
print("=" * 70)

print(
    f"Accuracy: {pers_accuracy:.4f}"
)

print(
    f"Macro F1: {pers_macro_f1:.4f}"
)

print("\nClassification report:")

print(
    classification_report(
        gold_persuasions,
        pred_persuasions,
        digits=4,
        zero_division=0,
    )
)

persuasion_labels = sorted(
    set(gold_persuasions)
    |
    set(pred_persuasions)
)

print(
    "Persuasion labels:",
    persuasion_labels
)

print("\nConfusion matrix:")

print(
    confusion_matrix(
        gold_persuasions,
        pred_persuasions,
        labels=persuasion_labels,
    )
)


# ============================================================
# JOINT ACCURACY
# ============================================================

joint_correct = sum(
    (
        gc == pc
        and
        gp == pp
    )
    for gc, pc, gp, pp
    in zip(
        gold_categories,
        pred_categories,
        gold_persuasions,
        pred_persuasions,
    )
)

joint_accuracy = (
    joint_correct / total
)

print("\n")
print("=" * 70)
print("JOINT PERFORMANCE")
print("=" * 70)

print(
    "Both labels correct:",
    joint_correct,
    "/",
    total,
)

print(
    f"Joint accuracy: {joint_accuracy:.4f}"
)


print("\nPredictions saved to:")
print(RESULTS_FILE)
