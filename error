import json
import re
import unicodedata
from pathlib import Path

import pandas as pd
from sklearn.model_selection import train_test_split
from transformers import AutoTokenizer

from common import (
    MODEL_NAME, MAX_LENGTH, CATEGORIES, PERSUASIONS,
    POSITION_TO_PERSUASION, build_prompt, build_target,
)

INPUT_FILE = "processed/families_labeled.csv"
OUT_DIR = Path("training_data_clean")
OUT_DIR.mkdir(parents=True, exist_ok=True)

SEED = 42
VALID_FRACTION = 0.15

# ------------------------------------------------------------
# Load and validate columns
# ------------------------------------------------------------
df = pd.read_csv(INPUT_FILE)

required = {"family_id", "variant_position", "language", "category", "prompt"}
missing = required - set(df.columns)
if missing:
    raise ValueError(f"Missing columns: {sorted(missing)}")

df["family_id"] = df["family_id"].astype(int)
df["variant_position"] = df["variant_position"].astype(int)
df["prompt"] = df["prompt"].fillna("").astype(str)

expected_persuasion = df["variant_position"].map(POSITION_TO_PERSUASION)
if "persuasion_type" not in df.columns:
    df["persuasion_type"] = expected_persuasion
if (df["persuasion_type"] != expected_persuasion).any():
    raise ValueError("persuasion_type does not match variant_position mapping.")

bad_cat = set(df["category"]) - set(CATEGORIES)
if bad_cat:
    raise ValueError(f"Unknown categories: {bad_cat}")

print("Rows:", len(df), "| Families:", df["family_id"].nunique())

# ------------------------------------------------------------
# Original row id (needed for cross-language alignment)
# ------------------------------------------------------------
derived_id = (df["family_id"] - 1) * 7 + df["variant_position"] + 1
if "id" in df.columns:
    df["row_id"] = df["id"].astype(int)
    if (df["row_id"] != derived_id).any():
        raise ValueError("Row ids are not aligned with family_id/variant_position.")
else:
    df["row_id"] = derived_id

# ------------------------------------------------------------
# Cross-lingual intent slot
# ids 1-7000: 5 language blocks of 1400 rows (6 categories)
# ids 7001-7840: Gov_Decision, 5 language blocks of 168 rows
# ------------------------------------------------------------
def intent_slot(row_id):
    if row_id <= 7000:
        return ((row_id - 1) % 1400) // 7
    return 200 + ((row_id - 7001) % 168) // 7

df["intent_slot"] = df["row_id"].map(intent_slot).astype(int)

slot_check = df.groupby("intent_slot").agg(
    n_lang=("language", "nunique"),
    n_cat=("category", "nunique"),
    n_fam=("family_id", "nunique"),
)
if not (slot_check["n_cat"] == 1).all():
    raise ValueError("An intent slot spans multiple categories; alignment assumption is wrong.")
if not ((slot_check["n_lang"] == 5) & (slot_check["n_fam"] == 5)).all():
    raise ValueError("An intent slot does not contain exactly one family per language.")

print("Intent slots:", df["intent_slot"].nunique())

print("\nAlignment spot-check (slot 0, plain prompt, all languages):")
print(
    df[(df["intent_slot"] == 0) & (df["variant_position"] == 0)]
    [["row_id", "language", "prompt"]].to_string(index=False)
)

# ------------------------------------------------------------
# Remove corrupted families (whole family, not one row)
# ------------------------------------------------------------
corrupted = df[df["prompt"].str.strip().str.len() < 3]
corrupted_families = sorted(corrupted["family_id"].unique().tolist())
if corrupted_families:
    print("\nRemoving corrupted families:", corrupted_families)
    print(corrupted[["family_id", "variant_position", "language", "prompt"]].to_string(index=False))
    df = df[~df["family_id"].isin(corrupted_families)].copy()

sizes = df.groupby("family_id").size()
if not (sizes == 7).all():
    raise ValueError("Incomplete families remain after cleaning.")

# ------------------------------------------------------------
# Merge intent slots that share an identical prompt
# ------------------------------------------------------------
def normalize(text):
    text = unicodedata.normalize("NFKC", text).casefold()
    return re.sub(r"\s+", " ", text).strip()

df["norm_prompt"] = df["prompt"].map(normalize)

parent = {int(s): int(s) for s in df["intent_slot"].unique()}

def find(x):
    while parent[x] != x:
        parent[x] = parent[parent[x]]
        x = parent[x]
    return x

def union(a, b):
    ra, rb = find(a), find(b)
    if ra != rb:
        parent[max(ra, rb)] = min(ra, rb)

for _, group in df.groupby("norm_prompt"):
    slots = [int(s) for s in group["intent_slot"].unique()]
    for s in slots[1:]:
        union(slots[0], s)

df["intent_group"] = df["intent_slot"].map(lambda s: find(int(s)))
merged = df["intent_slot"].nunique() - df["intent_group"].nunique()
print(f"\nIntent groups: {df['intent_group'].nunique()} (merged {merged} duplicate slots)")

# ------------------------------------------------------------
# Split by intent group, stratified by category
# ------------------------------------------------------------
groups = df.groupby("intent_group").agg(
    category=("category", "first"),
    n_cat=("category", "nunique"),
)
if not (groups["n_cat"] == 1).all():
    raise ValueError("An intent group spans multiple categories.")

train_groups, valid_groups = train_test_split(
    groups.index.tolist(),
    test_size=VALID_FRACTION,
    random_state=SEED,
    shuffle=True,
    stratify=groups["category"].tolist(),
)
train_groups, valid_groups = set(train_groups), set(valid_groups)

train_df = df[df["intent_group"].isin(train_groups)].copy()
valid_df = df[df["intent_group"].isin(valid_groups)].copy()

# ------------------------------------------------------------
# Leakage assertions
# ------------------------------------------------------------
assert not (train_groups & valid_groups), "Intent-group leakage"
assert not (set(train_df["family_id"]) & set(valid_df["family_id"])), "Family leakage"
assert not (set(train_df["norm_prompt"]) & set(valid_df["norm_prompt"])), "Prompt-text leakage"
assert len(train_df) + len(valid_df) == len(df)

# ------------------------------------------------------------
# Build prompt/completion text and check lengths
# ------------------------------------------------------------
tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME, trust_remote_code=True)
eos = tokenizer.eos_token
print("\nEOS token:", repr(eos))

def add_text(frame):
    frame["prompt_text"] = frame["prompt"].map(lambda p: build_prompt(tokenizer, p))
    frame["completion_text"] = [
        build_target(c, p) + eos
        for c, p in zip(frame["category"], frame["persuasion_type"])
    ]
    return frame

train_df = add_text(train_df)
valid_df = add_text(valid_df)

all_text = pd.concat([train_df, valid_df])
lengths = [
    len(tokenizer(a + b, add_special_tokens=False)["input_ids"])
    for a, b in zip(all_text["prompt_text"], all_text["completion_text"])
]
max_tokens = max(lengths)
print("Max sequence length (tokens):", max_tokens)
if max_tokens >= MAX_LENGTH:
    raise ValueError(f"Longest example ({max_tokens}) exceeds MAX_LENGTH ({MAX_LENGTH}).")

# ------------------------------------------------------------
# Write JSONL
# ------------------------------------------------------------
def write_jsonl(frame, path):
    with open(path, "w", encoding="utf-8") as f:
        for _, r in frame.iterrows():
            record = {
                "prompt": r["prompt_text"],
                "completion": r["completion_text"],
                "user_prompt": r["prompt"],
                "category": r["category"],
                "persuasion": r["persuasion_type"],
                "language": r["language"],
                "family_id": int(r["family_id"]),
                "intent_group": int(r["intent_group"]),
            }
            f.write(json.dumps(record, ensure_ascii=False) + "\n")

train_df = train_df.sample(frac=1, random_state=SEED).reset_index(drop=True)
valid_df = valid_df.sort_values(["family_id", "variant_position"]).reset_index(drop=True)

write_jsonl(train_df, OUT_DIR / "safety_understanding_train.jsonl")
write_jsonl(valid_df, OUT_DIR / "safety_understanding_valid.jsonl")

manifest = {
    "seed": SEED,
    "split_unit": "cross-lingual intent group",
    "train_intent_groups": len(train_groups),
    "valid_intent_groups": len(valid_groups),
    "train_families": int(train_df["family_id"].nunique()),
    "valid_families": int(valid_df["family_id"].nunique()),
    "train_rows": len(train_df),
    "valid_rows": len(valid_df),
    "corrupted_families_removed": [int(x) for x in corrupted_families],
    "max_tokens": int(max_tokens),
    "max_length": MAX_LENGTH,
}
with open(OUT_DIR / "split_manifest.json", "w", encoding="utf-8") as f:
    json.dump(manifest, f, indent=2)

print("\n" + "=" * 60)
for k, v in manifest.items():
    print(f"{k}: {v}")
print("\nValidation categories:\n", valid_df["category"].value_counts())
print("\nValidation languages:\n", valid_df["language"].value_counts())
print("\nValidation persuasion:\n", valid_df["persuasion_type"].value_counts())
