import json
import torch

from transformers import AutoTokenizer, AutoModelForCausalLM
from peft import PeftModel


# ============================================================
# CONFIG
# ============================================================

BASE_MODEL = "Qwen/Qwen3-8B"

ADAPTER_PATH = "./outputs/safety_understanding/best_adapter"

VALID_FILE = "training_data/safety_understanding_valid.jsonl"

NUM_EXAMPLES = 10
MAX_NEW_TOKENS = 64


# ============================================================
# EXACT SYSTEM PROMPT USED DURING TRAINING
# ============================================================

TRAIN_SYSTEM_PROMPT = """You are a multilingual safety analysis system.

Given a user prompt, identify:

1. safety category
2. persuasion strategy

Return ONLY valid JSON.

Schema:

{
  "category": "...",
  "persuasion": "..."
}"""


# ============================================================
# LOAD VALIDATION DATA
# ============================================================

print("Loading validation data...")

with open(VALID_FILE, "r", encoding="utf-8") as f:
    dataset = [
        json.loads(line)
        for line in f
        if line.strip()
    ]

print("Validation examples:", len(dataset))


# ============================================================
# LOAD TOKENIZER
# ============================================================

print("Loading tokenizer...")

tokenizer = AutoTokenizer.from_pretrained(
    BASE_MODEL,
    trust_remote_code=True,
)

if tokenizer.pad_token is None:
    tokenizer.pad_token = tokenizer.eos_token


# ============================================================
# LOAD BASE MODEL
# ============================================================

print("Loading base model...")

base_model = AutoModelForCausalLM.from_pretrained(
    BASE_MODEL,
    dtype=torch.bfloat16,
    device_map="auto",
    trust_remote_code=True,
)


# ============================================================
# LOAD LORA ADAPTER
# ============================================================

print("Loading LoRA adapter...")

model = PeftModel.from_pretrained(
    base_model,
    ADAPTER_PATH,
)

model.eval()

print("Active adapter:", model.active_adapter)


# ============================================================
# DEVICE
# ============================================================

device = next(model.parameters()).device

print("Device:", device)


# ============================================================
# GENERATION
# ============================================================

def generate(system_prompt, user_prompt):

    messages = [
        {
            "role": "system",
            "content": system_prompt,
        },
        {
            "role": "user",
            "content": user_prompt,
        },
    ]

    prompt = tokenizer.apply_chat_template(
        messages,
        tokenize=False,
        add_generation_prompt=True,
        enable_thinking=False,
    )

    inputs = tokenizer(
        prompt,
        return_tensors="pt",
    )

    # Move tensors only.
    for key in inputs:
        if torch.is_tensor(inputs[key]):
            inputs[key] = inputs[key].to(device)

    with torch.inference_mode():

        output = model.generate(
            **inputs,
            max_new_tokens=MAX_NEW_TOKENS,
            do_sample=False,
            eos_token_id=tokenizer.eos_token_id,
            pad_token_id=tokenizer.eos_token_id,
            use_cache=True,
        )

    prompt_length = inputs["input_ids"].shape[1]

    generated_tokens = output[0, prompt_length:]

    decoded = tokenizer.decode(
        generated_tokens,
        skip_special_tokens=True,
    ).strip()

    return decoded


# ============================================================
# JSON PARSER
# ============================================================

def parse_json(text):

    try:
        result = json.loads(text)

        if isinstance(result, dict):
            return result

    except (json.JSONDecodeError, TypeError):
        pass

    return None


# ============================================================
# COUNTERS
# ============================================================

validation_json_success = 0
training_json_success = 0

validation_correct = 0
training_correct = 0


# ============================================================
# TEST FIRST N VALIDATION EXAMPLES
# ============================================================

num_examples = min(
    NUM_EXAMPLES,
    len(dataset),
)

for idx in range(num_examples):

    example = dataset[idx]

    messages = example["messages"]

    validation_system_prompt = messages[0]["content"]

    user_prompt = messages[1]["content"]

    gold = json.loads(
        messages[2]["content"]
    )


    # --------------------------------------------------------
    # TEST A
    # Use system prompt stored in validation file
    # --------------------------------------------------------

    validation_output = generate(
        validation_system_prompt,
        user_prompt,
    )

    validation_prediction = parse_json(
        validation_output
    )


    # --------------------------------------------------------
    # TEST B
    # Same user prompt but exact training system prompt
    # --------------------------------------------------------

    training_output = generate(
        TRAIN_SYSTEM_PROMPT,
        user_prompt,
    )

    training_prediction = parse_json(
        training_output
    )


    # --------------------------------------------------------
    # SCORE A
    # --------------------------------------------------------

    if validation_prediction is not None:

        validation_json_success += 1

        if (
            validation_prediction.get("category")
            == gold["category"]
            and
            validation_prediction.get("persuasion")
            == gold["persuasion"]
        ):
            validation_correct += 1


    # --------------------------------------------------------
    # SCORE B
    # --------------------------------------------------------

    if training_prediction is not None:

        training_json_success += 1

        if (
            training_prediction.get("category")
            == gold["category"]
            and
            training_prediction.get("persuasion")
            == gold["persuasion"]
        ):
            training_correct += 1


    # --------------------------------------------------------
    # PRINT EXAMPLE
    # --------------------------------------------------------

    print("\n" + "=" * 70)
    print(f"EXAMPLE {idx}")
    print("=" * 70)

    print("\nGOLD:")
    print(gold)

    print("\n[A] VALIDATION SYSTEM PROMPT OUTPUT:")
    print(repr(validation_output))

    print("PARSED:")
    print(validation_prediction)

    print("\n[B] TRAINING SYSTEM PROMPT OUTPUT:")
    print(repr(training_output))

    print("PARSED:")
    print(training_prediction)


# ============================================================
# SUMMARY
# ============================================================

print("\n" + "=" * 70)
print("SUMMARY")
print("=" * 70)

print("\nA. Validation system prompt")

print(
    f"Valid JSON: "
    f"{validation_json_success}/{num_examples}"
)

print(
    f"Joint correct: "
    f"{validation_correct}/{num_examples}"
)


print("\nB. Exact training system prompt")

print(
    f"Valid JSON: "
    f"{training_json_success}/{num_examples}"
)

print(
    f"Joint correct: "
    f"{training_correct}/{num_examples}"
)
